# Copy to .env next to docker-compose.yml and fill in the required values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── REQUIRED ──────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH=

# ── URLs (defaults match docker-compose) ──────────────────────────────────
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_URL=http://localhost:3000

# ── Stripe (leave empty to run… actually the API REFUSES fake payments in
#    production mode — provide test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ── Email (OTP + password reset won't send without this) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Misc ──────────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
SEED_DEMO_DATA=false

# Reverse proxy trust for correct client-IP rate limiting
TRUST_PROXY=loopback
